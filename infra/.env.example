# PostgreSQL credentials
TENTACLES_USERNAME=tentacles
TENTACLES_PASSWORD=change_me

# Authentik OIDC configuration
AUTHENTIK_CLIENT_ID=your_authentik_client_id
AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret
AUTHENTIK_ISSUER_URI=https://your-authentik-server/application/o/tentacles/

# Public URL where users access Tentacles
TENTACLES_PUBLIC_BASE_URL=https://tentacles.example.com
TENTACLES_UPLOAD_DIR=/app/uploads
# Required for direct Compose use; deploy.ps1 supplies this automatically.
# Choose a published tag from GitHub Releases (for example v1.7.2).
TENTACLES_VERSION=
